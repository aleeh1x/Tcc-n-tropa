CSS PERFIL

@import url('https://fonts.googleapis.com/css2?family=Bebas+Neue&display=swap');


* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}


body {
    display: flex;
    justify-content: center;
    min-height: 100vh;
    align-items: center;    
    background: url(backgroundpreto.avif);
}

.container {
    border-radius: 40px;
    background-color: transparent;
    width: 600px;
    border: 4px solid rgb(155, 155, 155);
    box-shadow: 0 0 10px rgba(0, 0, 0, .2);
    color: white;
    padding: 30px 40px 20px 40px;
}

.container h1  {
    font-size: 50px;
    text-align: center;
}

.foto {
    display: flex;
    justify-content: center;
    margin: 10px 0 15px;
}
.foto img {
    width: 250px;
    height: 250px;
    border-radius: 50%;
    object-fit: cover;
    border: 4px solid white;
}
.input-box {
    position: relative;
    width: 100%;
    height: 50px;
    margin: 30px 0px;
    color: white;
}
.input-box input {
  border: none;
  outline: none;
  border-bottom: 2px solid hsl(0, 0%, 100%);
  padding: 8px 0; 
  background-color: transparent;
  width: 100%;
  height: 100%;
  padding: 20px 45px 20px 20px;
  color: white;
}

.salvar button {
    border-radius: 10px;
    width: 75px;
    height: 40px;
    background-color: rgb(85, 85, 250);
    float: right;
    border: none;
    color: white;
    font-weight: bold;
    font-size: medium;
    cursor: pointer;
}

.reset button {
    border: none;
    background-color: transparent;
    font-weight: bold;
    color: white;
    cursor: pointer;
    font-size: medium;
    
}
.reset button a:hover {
    text-decoration: underline;
}




