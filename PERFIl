CSS PERFIL

@import url('https://fonts.googleapis.com/css2?family=Bebas+Neue&display=swap');


* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}


body {
    display: flex;
    justify-content: center;
    min-height: 100vh;
    align-items: center;    
    background: url(imagem.png);
    background-position: center;
    background-size: cover;
    background-repeat: no-repeat;
}

.menu-lateral {
    position: fixed;
    left: -300px;
    top: 0;
    width: 300px;
    height: 100%;
    background-color: hwb(0 15% 84%);
    z-index: 2;
    box-shadow: 0 0 20px rgba(0, 0, 0, 0.1);
    border-radius: 10px;
}   

.menu-lateral.ativo {
    left: 0;

}   

.menu-lateral ul {
    list-style-type: none;
    padding: 0;
    margin-top: 90px;
}

.menu-lateral ul li {
    padding: 15px 30px;

}
.menu-lateral ul li a {
    text-decoration: none;
    color: #ecf0f1;
    font-size: 18px;
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}

.menu-lateral ul li:hover {
    background-color: hsl(0, 0%, 41%);
}

.menu-lateral ul li a i:hover {
    transform: translateX(5px) rotate(5deg);
}


.menu-lateral ul li a i {
    font-size: 24px
}

.botao-menu {
    background-color: hwb(0 41% 59%) ;
    position: fixed;
    left: 20px;
    top: 20px;
    z-index: 3;
    border-radius: 5px;
    font-size: 24px;
    border: none;
    padding: 10px 15px;
    cursor: pointer;
    color:black;
    margin: 10px;
}

.botao-menu:hover {
    background-color: hwb(0 21% 79%);
}

.botao-menu.ativo {
    left: 320px;
}

.container {
    border-radius: 40px;
    background-color: transparent;
    width: 600px;
    border: 4px solid rgb(155, 155, 155);
    box-shadow: 0 0 10px rgba(0, 0, 0, .2);
    color: white;
    padding: 30px 40px 20px 40px;
    box-shadow: 0 0 20px rgba(0, 0, 0, 0.1);
}

.container h1  {
    font-size: 50px;
    text-align: center;
    font: bold;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}

.foto {
    display: flex;
    justify-content: center;
    margin: 10px 0 15px;
}
.foto img {
    width: 250px;
    height: 250px;
    border-radius: 50%;
    object-fit: cover;
    border: 4px solid white;
}
.input-box {
    position: relative;
    width: 100%;
    height: 50px;
    margin: 30px 0px;
    color: white;
}
.input-box input {
  border: none;
  outline: none;
  border-bottom: 2px solid hsl(0, 0%, 100%);
  padding: 8px 0; 
  background-color: transparent;
  width: 100%;
  height: 100%;
  padding: 20px 45px 20px 20px;
  color: white;
  border-radius: 10px;
}

.salvar button {
    border-radius: 10px;
    width: 75px;
    height: 40px;
    background-color: rgb(85, 85, 250);
    float: right;
    border: none;
    color: white;
    font-weight: bold;
    font-size: medium;
    cursor: pointer;
}

.reset button {
    border: none;
    background-color: transparent;
    font-weight: bold;
    color: white;
    cursor: pointer;
    font-size: medium;
    
}
.reset button a:hover {
    text-decoration: underline;
}  



